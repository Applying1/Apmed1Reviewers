{"v":1,"cards":[{"i":"n5669ba3475","c":"1","t":"Basics","f":"Bill of Rights","b":"Article III of the 1987 Constitution; 22 sections","k":"b"},{"i":"ne877272c58","c":"1","t":"Basics","f":"Concept","b":"declaration and enumeration of rights protected against the government or other people","k":"b"},{"i":"n4105aa03ec","c":"1","t":"Basics","f":"Also","b":"a charter of liberties and a limitation on the power of the State","k":"b"},{"i":"n9dd7590cab","c":"1","t":"Section 1","f":"Due process","b":"fair procedure: notice, a chance to defend yourself, fair treatment","k":"b"},{"i":"n9a01f65f1d","c":"1","t":"Section 1","f":"Equal protection","b":"everyone treated equally regardless of race, religion, gender, status, nationality, beliefs","k":"b"},{"i":"nf0056496fe","c":"1","t":"Section 1","f":"Protects","b":"life, liberty and property","k":"b"},{"i":"ne9d5292a10","c":"1","t":"Right to liberty (5 parts)","f":"Right to exist","b":"live, not deprived without lawful reason","k":"b"},{"i":"nd089ed9d9f","c":"1","t":"Right to liberty (5 parts)","f":"Free from restraint or servitude","b":"no slavery, forced labor, unjust imprisonment","k":"b"},{"i":"n180160cb7e","c":"1","t":"Right to liberty (5 parts)","f":"Right to contract","b":"leases, jobs, businesses","k":"b"},{"i":"n80fb77300e","c":"1","t":"Right to liberty (5 parts)","f":"Choose one's employment","b":"your own job or profession","k":"b"},{"i":"n51ccddeeb7","c":"1","t":"Right to liberty (5 parts)","f":"Right to labor","b":"work and earn a living; safe, fair conditions","k":"b"},{"i":"n79a1f5ba7a","c":"1","t":"Crimes against person","f":"Homicide","b":"killing without a qualifying circumstance","k":"b"},{"i":"n978ec00e25","c":"1","t":"Crimes against person","f":"Murder","b":"killing with treachery or evident premeditation","k":"b"},{"i":"nf0adbdefb4","c":"1","t":"Crimes against person","f":"Parricide","b":"killing family members","k":"b"},{"i":"n181ab7abd1","c":"1","t":"Crimes against person","f":"Infanticide","b":"newborn less than 3 days old","k":"b"},{"i":"n24a8df4661","c":"1","t":"Crimes against person","f":"Physical injuries","b":"serious (disability), slight (bruises)","k":"b"},{"i":"n26627750a9","c":"1","t":"Crimes against liberty","f":"Kidnapping","b":"carrying away against their will","k":"b"},{"i":"n1c566895ef","c":"1","t":"Crimes against liberty","f":"Illegal detention","b":"keeping someone from leaving","k":"b"},{"i":"n04ecd190d5","c":"1","t":"Crimes against liberty","f":"Serious illegal detention","b":"abducting and holding captive","k":"b"},{"i":"n284ea223a5","c":"1","t":"Crimes against liberty","f":"Coercion","b":"forcing through violence or threats","k":"b"},{"i":"nc962121b12","c":"1","t":"Crimes against liberty","f":"Grave threats","b":"threatening a serious crime","k":"b"},{"i":"n7e475fcc55","c":"1","t":"Crimes against liberty","f":"Unlawful arrest","b":"fake officer arrests","k":"b"},{"i":"n3183a5d02b","c":"1","t":"Crimes against liberty","f":"Human trafficking","b":"fake job offer, exploitation","k":"b"},{"i":"n27ae6e4b90","c":"1","t":"Crimes against liberty","f":"Arbitrary detention","b":"by a public officer","k":"b"},{"i":"nda60003828","c":"1","t":"Crimes against property","f":"Robbery","b":"with violence or force","k":"b"},{"i":"n01b14d8138","c":"1","t":"Crimes against property","f":"Theft","b":"without violence","k":"b"},{"i":"n12d3acc853","c":"1","t":"Crimes against property","f":"Qualified theft","b":"employee steals from employer","k":"b"},{"i":"n70ed5ca25c","c":"1","t":"Crimes against property","f":"Estafa","b":"swindling by deceit","k":"b"},{"i":"ncf355053e4","c":"1","t":"Crimes against property","f":"Arson","b":"setting fire","k":"b"},{"i":"ne1dc531528","c":"1","t":"Crimes against property","f":"Malicious mischief","b":"smashing windows","k":"b"},{"i":"n8d6bf445a9","c":"1","t":"Crimes against property","f":"Carnapping","b":"motor vehicles","k":"b"},{"i":"nd30455d8d9","c":"1","t":"Crimes against property","f":"Fencing","b":"dealing in stolen goods","k":"b"},{"i":"nd1fbe1e282","c":"1","t":"Crimes against property","f":"Forgery","b":"falsifying documents or signatures","k":"b"},{"i":"n839da4f576","c":"1","t":"Section 2: search and seizure","f":"Covers","b":"persons, houses, papers and effects","k":"b"},{"i":"n7329a9a5e6","c":"1","t":"Section 2: search and seizure","f":"Warrant needs","b":"probable cause determined personally by the judge, after examination under oath","k":"b"},{"i":"n75856d096c","c":"1","t":"Section 2: search and seizure","f":"Must describe","b":"the place to be searched, persons or things to be seized","k":"b"},{"i":"nba671a2088","c":"1","t":"Section 2: search and seizure","f":"Person","b":"citizens and aliens, accused or not","k":"b"},{"i":"n08c213359a","c":"1","t":"Section 2: search and seizure","f":"Houses","b":"also garages, warehouses, shops, offices, safety deposit vaults","k":"b"},{"i":"n3049231185","c":"1","t":"Section 2: search and seizure","f":"Papers and effects","b":"includes sealed letters and packages","k":"b"},{"i":"nf3f4570ada","c":"1","t":"Section 2: search and seizure","f":"Consent","b":"makes a search legal (James at the bus stop)","k":"b"},{"i":"n16856e00cd","c":"1","t":"Warrants","f":"Search warrant","b":"written order signed by a judge, directed to a peace officer, to search for property and bring it to court","k":"b"},{"i":"n58112d035f","c":"1","t":"Warrants","f":"Warrant of arrest","b":"written order by the judge to take a person into custody to answer for an offense","k":"b"},{"i":"n592f420b28","c":"1","t":"Section 3: privacy","f":"Rule","b":"communication and correspondence are inviolable","k":"b"},{"i":"nc4a3317535","c":"1","t":"Section 3: privacy","f":"Exceptions","b":"lawful court order; public safety or order as prescribed by law","k":"b"},{"i":"nf335f3121a","c":"1","t":"Section 3: privacy","f":"Evidence obtained illegally","b":"inadmissible for any purpose","k":"b"},{"i":"nf76bdbc454","c":"1","t":"Sections 4–11","f":"4","b":"speech, expression, press, assembly, petition","k":"b"},{"i":"n0204a989d7","c":"1","t":"Sections 4–11","f":"5","b":"religion; no religious test","k":"b"},{"i":"na1fd623aee","c":"1","t":"Sections 4–11","f":"6","b":"abode (court order) and travel (national security, public safety, public health)","k":"b"},{"i":"nd9083bf1b9","c":"1","t":"Sections 4–11","f":"7","b":"information on public concern","k":"b"},{"i":"n2c1c1fac78","c":"1","t":"Sections 4–11","f":"8","b":"form unions, associations","k":"b"},{"i":"nb1e10c87a6","c":"1","t":"Sections 4–11","f":"9","b":"just compensation","k":"b"},{"i":"n7934616f3c","c":"1","t":"Sections 4–11","f":"10","b":"non-impairment of contracts","k":"b"},{"i":"ne4d382e6d0","c":"1","t":"Sections 4–11","f":"11","b":"free access to courts despite poverty","k":"b"},{"i":"nfd6c94bb80","c":"1","t":"Sections 12–17","f":"12","b":"custodial investigation: silent, counsel (provided if poor), waiver only in writing with counsel; no torture or secret detention; forced confessions inadmissible","k":"b"},{"i":"n2bbdbd909e","c":"1","t":"Sections 12–17","f":"13","b":"bail, except reclusion perpetua with strong evidence; surety or recognizance; still applies when habeas corpus is suspended","k":"b"},{"i":"n8c01859708","c":"1","t":"Sections 12–17","f":"14","b":"rights of the accused: presumed innocent, counsel, know the charges, speedy public trial, confront witnesses; trial in absentia after arraignment","k":"b"},{"i":"neb20ab664c","c":"1","t":"Sections 12–17","f":"15","b":"habeas corpus; suspended only in invasion or rebellion","k":"b"},{"i":"ne7ced75452","c":"1","t":"Sections 12–17","f":"16","b":"speedy disposition of cases","k":"b"},{"i":"n4a22120ed9","c":"1","t":"Sections 12–17","f":"17","b":"against self-incrimination; burden of proof on the government","k":"b"},{"i":"n8fbf7ee6b5","c":"1","t":"Sections 18–22","f":"18","b":"no detention for political beliefs; no involuntary servitude except as punishment after conviction","k":"b"},{"i":"naf00f7ca3b","c":"1","t":"Sections 18–22","f":"19","b":"no excessive fines or cruel punishment; death penalty only if Congress provides for heinous crimes, else reclusion perpetua","k":"b"},{"i":"nd1bf0d98ba","c":"1","t":"Sections 18–22","f":"20","b":"no prison for debt or poll tax","k":"b"},{"i":"n4f2fdf33c7","c":"1","t":"Sections 18–22","f":"21","b":"double jeopardy","k":"b"},{"i":"na4db56778a","c":"1","t":"Sections 18–22","f":"22","b":"no ex post facto law (retroactive), no bill of attainder (guilty without trial)","k":"b"},{"i":"n922143ac78","c":"2","t":"Leadership","f":"Leadership","b":"the ability to influence and guide followers or members of an organization","k":"b"},{"i":"n36e019db3d","c":"2","t":"Leadership","f":"Also","b":"the ability to motivate people to accomplish goals","k":"b"},{"i":"nbdf2549852","c":"2","t":"10 characteristics of a good leader","f":"Vision","b":"knows where to go, makes people believe","k":"b"},{"i":"n9d272105af","c":"2","t":"10 characteristics of a good leader","f":"Wit","b":"sound judgment even in crucial situations","k":"b"},{"i":"n8d1b9462cd","c":"2","t":"10 characteristics of a good leader","f":"Passion","b":"intensely obsessed with their focus","k":"b"},{"i":"n0c4b354550","c":"2","t":"10 characteristics of a good leader","f":"Compassion","b":"for supporters and followers","k":"b"},{"i":"neeca99fe3d","c":"2","t":"10 characteristics of a good leader","f":"Charisma","b":"captivating, charming, draws people","k":"b"},{"i":"ne46573cc5d","c":"2","t":"10 characteristics of a good leader","f":"Communication skills","b":"great orators and persuaders","k":"b"},{"i":"n61d5913d2b","c":"2","t":"10 characteristics of a good leader","f":"Persistence","b":"goals despite obstacles","k":"b"},{"i":"n07fcbd7238","c":"2","t":"10 characteristics of a good leader","f":"Integrity","b":"walk the talk, keep promises","k":"b"},{"i":"n535cfa689d","c":"2","t":"10 characteristics of a good leader","f":"Daring","b":"bold, takes risks amid fear","k":"b"},{"i":"n0bc623cc14","c":"2","t":"10 characteristics of a good leader","f":"Discipline","b":"self-control and order","k":"b"},{"i":"nc94c11c2fc","c":"2","t":"Traits of a leader: Maxwell (1999)","f":"Six C's","b":"character, charisma, commitment, communication, competence, courage","k":"b"},{"i":"n529ab1e1ab","c":"2","t":"Transactional vs transformational","f":"Transactional","b":"corrective action, rewards only when expectations are met; tells each person what, when and how; power through rewards and coercion (patronage, colonization, vote-buying)","k":"b"},{"i":"nd54834f3ce","c":"2","t":"Transactional vs transformational","f":"Transformational","b":"starts from members' needs, rewards related to effort; trusts subordinates, gives space to grow; lives out values, approachable, accepts pressure to perform","k":"b"},{"i":"n0b3a90cd5e","c":"2","t":"Transactional vs transformational","f":"Definition","b":"broadens and elevates employees' interests, builds acceptance of the group's mission, looks beyond self-interest","k":"b"},{"i":"nfaa537fe05","c":"2","t":"Transactional vs transformational","f":"Summary","b":"a framework that brings people together around a common vision","k":"b"},{"i":"nd2c65318ed","c":"2","t":"13 behaviors of a transformational leader","f":"1","b":"articulate, compelling vision of the future","k":"b"},{"i":"nfd051176eb","c":"2","t":"13 behaviors of a transformational leader","f":"2","b":"stories and symbols","k":"b"},{"i":"n38406c6d5e","c":"2","t":"13 behaviors of a transformational leader","f":"3","b":"strong sense of purpose and collective mission","k":"b"},{"i":"nb9c1855551","c":"2","t":"13 behaviors of a transformational leader","f":"4","b":"talks optimistically, confident goals will be met","k":"b"},{"i":"n3839ca7247","c":"2","t":"13 behaviors of a transformational leader","f":"5","b":"does the right thing, not just things right","k":"b"},{"i":"ne950288a25","c":"2","t":"13 behaviors of a transformational leader","f":"6","b":"instills pride","k":"b"},{"i":"ndc51e7d031","c":"2","t":"13 behaviors of a transformational leader","f":"7","b":"talks about values and beliefs","k":"b"},{"i":"n9247d18854","c":"2","t":"13 behaviors of a transformational leader","f":"8","b":"moral and ethical consequences","k":"b"},{"i":"n220dbf50c5","c":"2","t":"13 behaviors of a transformational leader","f":"9","b":"seeks different perspectives","k":"b"},{"i":"n1147306ebb","c":"2","t":"13 behaviors of a transformational leader","f":"10","b":"challenge old assumptions","k":"b"},{"i":"n679ed96a4f","c":"2","t":"13 behaviors of a transformational leader","f":"11","b":"teaching and coaching","k":"b"},{"i":"n2ad01c980f","c":"2","t":"13 behaviors of a transformational leader","f":"12","b":"each employee's needs, abilities, aspirations","k":"b"},{"i":"nba865f7c40","c":"2","t":"13 behaviors of a transformational leader","f":"13","b":"compassionate, appreciative, celebrates achievements","k":"b"},{"i":"ne159e37cae","c":"2","t":"4 components of transformational leadership","f":"Individualized (idealized) influence","b":"role model","k":"b"},{"i":"ne93826513b","c":"2","t":"4 components of transformational leadership","f":"Inspirational motivation","b":"positive attitude that inspires","k":"b"},{"i":"n143487e948","c":"2","t":"4 components of transformational leadership","f":"Intellectual stimulation","b":"involve teams in decisions, creativity, innovation","k":"b"},{"i":"n0739889c18","c":"2","t":"4 components of transformational leadership","f":"Individualized consideration","b":"relationships, individual support","k":"b"},{"i":"n5fd1fc79a0","c":"2","t":"Virtuous cycle of leadership control","f":"1","b":"energetic, sympathetic, friendly, understanding → enthusiastic cooperation","k":"b"},{"i":"ne8fdd1bacf","c":"2","t":"Virtuous cycle of leadership control","f":"2","b":"confidence in the job → confidence of followers","k":"b"},{"i":"n4e577a50e5","c":"2","t":"Virtuous cycle of leadership control","f":"3","b":"be an example to followers","k":"b"},{"i":"nea3074f9ec","c":"2","t":"7 habits of highly effective people","f":"Be proactive","b":"take responsibility for your life","k":"b"},{"i":"n9a39025c43","c":"2","t":"7 habits of highly effective people","f":"Begin with the end in mind","b":"know where you want to go","k":"b"},{"i":"ncdd02f1578","c":"2","t":"7 habits of highly effective people","f":"Put first things first","b":"self-management","k":"b"},{"i":"nadd9d29826","c":"2","t":"7 habits of highly effective people","f":"Think win-win","b":"cooperative, not competitive","k":"b"},{"i":"na7eefd49b6","c":"2","t":"7 habits of highly effective people","f":"Seek first to understand","b":"listen","k":"b"},{"i":"na60ddb4c32","c":"2","t":"7 habits of highly effective people","f":"Synergize","b":"better as a group","k":"b"},{"i":"n5ab66c9edf","c":"2","t":"7 habits of highly effective people","f":"Sharpen the saw","b":"keep updated, sense of humor","k":"b"},{"i":"n096d765989","c":"2","t":"Teamwork, time, decisions","f":"Teamwork","b":"working collaboratively with a group to achieve a goal","k":"b"},{"i":"n49f902a00f","c":"2","t":"Teamwork, time, decisions","f":"Time management","b":"arranging, organizing, scheduling, budgeting time for productivity","k":"b"},{"i":"n8bccc67abf","c":"2","t":"Teamwork, time, decisions","f":"Decision-making","b":"selecting the most logical choice from two or more options","k":"b"},{"i":"n794bfb0669","c":"2","t":"Teamwork, time, decisions","f":"Considerations","b":"identify alternatives → evaluate options → select the best","k":"b"},{"i":"n27b57a6451","c":"2","t":"8 kinds of involvement in decision-making","f":"Consensus","b":"compromise after all opinions are heard","k":"b"},{"i":"na4f008099b","c":"2","t":"8 kinds of involvement in decision-making","f":"Majority","b":"voting","k":"b"},{"i":"nca64c69514","c":"2","t":"8 kinds of involvement in decision-making","f":"Minority","b":"a few powerful personalities dominate","k":"b"},{"i":"n9870321d10","c":"2","t":"8 kinds of involvement in decision-making","f":"Silent consensus","b":"agreement without discussion; unanimous; rarely for important issues","k":"b"},{"i":"n039e9724cf","c":"2","t":"8 kinds of involvement in decision-making","f":"Clique","b":"small group plans beforehand","k":"b"},{"i":"n65880fbf89","c":"2","t":"8 kinds of involvement in decision-making","f":"Handclasp","b":"one suggests, another commends","k":"b"},{"i":"neb9ecf2a59","c":"2","t":"8 kinds of involvement in decision-making","f":"One-person decision","b":"quick, but hard to get support later","k":"b"},{"i":"n7d45490a2c","c":"2","t":"8 kinds of involvement in decision-making","f":"Plop","b":"deciding by not deciding","k":"b"},{"i":"n3988dcefe8","c":"2","t":"7 difficulties in decision-making","f":"Fear of consequences","b":"division, disagreement","k":"b"},{"i":"n0c284110db","c":"2","t":"7 difficulties in decision-making","f":"Conflicting loyalties","b":"member of different groups","k":"b"},{"i":"n99e14b9b3c","c":"2","t":"7 difficulties in decision-making","f":"Interpersonal conflicts","b":"personal differences","k":"b"},{"i":"nde6b6e6ff2","c":"2","t":"7 difficulties in decision-making","f":"Hidden agenda","b":"secret motive","k":"b"},{"i":"n28c3e00cbc","c":"2","t":"7 difficulties in decision-making","f":"Blundering methods","b":"rigid procedure, opinions over information","k":"b"},{"i":"nd393d4562f","c":"2","t":"7 difficulties in decision-making","f":"Inadequate leadership","b":"restricts opinions","k":"b"},{"i":"n912c6a349a","c":"2","t":"7 difficulties in decision-making","f":"Clash of interest","b":"opposing interests","k":"b"},{"i":"naa99fd02c1","c":"3","t":"Disease triangle","f":"Model","b":"interaction of host, agent and environment; predicts outcomes in plant and public health","k":"b"},{"i":"n529d3ccbf1","c":"3","t":"Disease triangle","f":"Host","b":"age, sex, race, genes, previous diseases, immune status, religion, customs, occupation, marital status, family","k":"b"},{"i":"n75a1fa1fa5","c":"3","t":"Disease triangle","f":"Environment","b":"temperature, humidity, altitude, crowding, housing, water, milk, food, radiation, pollution, noise","k":"b"},{"i":"n30c82fc7a1","c":"3","t":"Disease triangle","f":"Agent","b":"biologic (bacteria, viruses), chemical (poison, alcohol, smoke), physical (trauma, radiation, fire), nutritional (lack, excess)","k":"b"},{"i":"n3f227db54b","c":"3","t":"Communicable diseases","f":"Definition","b":"spread from person to person, \"catching\", caused by germs or pathogens","k":"b"},{"i":"n37418c8363","c":"3","t":"Communicable diseases","f":"Pathogens","b":"viruses, bacteria, parasitic worms, fungi","k":"b"},{"i":"ne387ab3ef4","c":"3","t":"Communicable diseases","f":"Food and water","b":"cholera, typhoid, hepatitis (jaundice)","k":"b"},{"i":"n232c224cf6","c":"3","t":"Communicable diseases","f":"Air","b":"influenza, tuberculosis","k":"b"},{"i":"nabdc99789d","c":"3","t":"Communicable diseases","f":"Mosquito","b":"malaria","k":"b"},{"i":"nf31c6431c9","c":"3","t":"Communicable diseases","f":"Bite wound with dust or rust","b":"tetanus","k":"b"},{"i":"n6423dcfe92","c":"3","t":"Dengue fever","f":"Cause","b":"one of 4 virus serotypes, genus Flavivirus, family Flaviviridae","k":"b"},{"i":"n94c5f37ee8","c":"3","t":"Dengue fever","f":"Symptoms","b":"fever, rash, rapid pulse, dizziness, adynamia, insomnia, red eyes and throat, pain in the bones, anorexia, vomiting","k":"b"},{"i":"nf86ed9377e","c":"3","t":"Dengue fever","f":"Prevention","b":"mosquitoes bite in the daytime; repellent (DEET, picaridin, IR3535); long sleeves, permethrin on clothes; screens, no standing water","k":"b"},{"i":"n0135655ae7","c":"3","t":"Malaria","f":"Cause","b":"Plasmodium parasite (falciparum most serious; vivax, ovale, malariae)","k":"b"},{"i":"ne708290cff","c":"3","t":"Malaria","f":"Vector","b":"female Anopheles mosquito","k":"b"},{"i":"n2bff3dc506","c":"3","t":"Malaria","f":"Symptoms","b":"flu-like, diarrhea, vomiting, joint pains, fever; a week up to a year after infection","k":"b"},{"i":"n36b9a42396","c":"3","t":"Malaria","f":"Treatment","b":"depends on type, age, severity","k":"b"},{"i":"n6f1228e63c","c":"3","t":"Malaria","f":"Prevention","b":"anti-malarial drugs, avoid bites","k":"b"},{"i":"n6901de5d86","c":"3","t":"Cholera","f":"Cause","b":"Vibrio cholerae in food or water; incubation under 1 day to 5 days","k":"b"},{"i":"ne2e121c580","c":"3","t":"Cholera","f":"Signs","b":"diarrhea, vomiting, loss of skin elasticity, low blood pressure, increased thirst, rapid weight loss","k":"b"},{"i":"n245e6f925c","c":"3","t":"Cholera","f":"Prevention","b":"boiled or chlorinated water, handwashing, wash fruits and vegetables, cook properly, eat hot food; report diarrhea","k":"b"},{"i":"n7c0d1cf241","c":"3","t":"Avian influenza and H1N1","f":"Bird flu","b":"influenza A viruses chiefly in birds","k":"b"},{"i":"na0ab806eda","c":"3","t":"Avian influenza and H1N1","f":"Bird flu signs","b":"cough, high fever, fatigue, headache, nose bleed, runny nose, upset stomach, loss of appetite","k":"b"},{"i":"n0a98c48178","c":"3","t":"Avian influenza and H1N1","f":"Bird flu prevention","b":"avoid poultry and droppings, cook poultry and eggs, wash hands, avoid wet and live poultry markets abroad, mask if unwell","k":"b"},{"i":"n1576f5fd3c","c":"3","t":"Avian influenza and H1N1","f":"H1N1","b":"swine flu; quadruple reassortant: 2 pig + 2 bird flu genes","k":"b"},{"i":"na0df5a51d4","c":"3","t":"Avian influenza and H1N1","f":"H1N1 signs","b":"systemic fever; psychological lethargy, lack of appetite; nasopharynx runny nose, sore throat; respiratory cough; gastric nausea, vomiting; intestinal diarrhea","k":"b"},{"i":"n1ea007ce3b","c":"3","t":"Avian influenza and H1N1","f":"H1N1 prevention","b":"vaccine (only preventable respiratory virus), wash hands, sanitizer, don't touch face, eat right, exercise, stay home 24 h after fever","k":"b"},{"i":"n6aa4590ec4","c":"3","t":"Typhoid fever","f":"Cause","b":"Salmonella typhi; S. paratyphi milder","k":"b"},{"i":"n30bc4ca2a2","c":"3","t":"Typhoid fever","f":"Spread","b":"human carrier deposits bacteria in food or water","k":"b"},{"i":"nd4780ebf74","c":"3","t":"Typhoid fever","f":"Signs","b":"white coating on the tongue, enlarged liver and spleen, rash, intestinal ulcers, high fever, delirium, abdominal pain, diarrhea or constipation","k":"b"},{"i":"n8fb5183df0","c":"3","t":"Typhoid fever","f":"Prevention","b":"hygiene, clean water, sewage disposal, fly control, wash food, cook well, no raw eggs, don't keep food warm or reheat","k":"b"},{"i":"nf6cc08e251","c":"3","t":"HIV/AIDS","f":"HIV","b":"attacks CD4 (T-helper) cells","k":"b"},{"i":"n46d4135574","c":"3","t":"HIV/AIDS","f":"AIDS","b":"most advanced stage","k":"b"},{"i":"nd8a8bc1197","c":"3","t":"HIV/AIDS","f":"Spread","b":"unprotected sex, sharing needles, infected blood (rare now: screening), mother-to-child, needlestick (occupational)","k":"b"},{"i":"n29df050e6b","c":"3","t":"HIV/AIDS","f":"Early stage","b":"2–4 weeks; flu-like","k":"b"},{"i":"n7a8717c05b","c":"3","t":"HIV/AIDS","f":"Clinical latency","b":"no symptoms for years; 5–10 years untreated","k":"b"},{"i":"n46751d569b","c":"3","t":"HIV/AIDS","f":"AIDS stage","b":"weight loss, night sweats, chronic diarrhea, TB, pneumonia, memory loss","k":"b"},{"i":"n5177a53f1a","c":"3","t":"HIV/AIDS","f":"Effects","b":"immune failure, neurological, social and psychological (stigma), economic","k":"b"},{"i":"n1d2bbdcfeb","c":"3","t":"HIV/AIDS","f":"Treatment","b":"no cure; ART suppresses the virus","k":"b"},{"i":"n36dd35c5a8","c":"3","t":"HIV/AIDS","f":"PrEP","b":"before, for high risk","k":"b"},{"i":"n034994c50f","c":"3","t":"HIV/AIDS","f":"PEP","b":"within 72 hours after exposure","k":"b"},{"i":"nb1da8a3d59","c":"3","t":"HIV/AIDS","f":"Prevention","b":"condoms, testing, no shared needles, safe transfusions, ART in pregnancy","k":"b"},{"i":"n780df71ae0","c":"3","t":"Non-communicable diseases","f":"Definition","b":"long duration, slow progression (chronic)","k":"b"},{"i":"n09adc0c262","c":"3","t":"Non-communicable diseases","f":"4 major","b":"cardiovascular diseases, diabetes, chronic respiratory diseases, cancer","k":"b"},{"i":"ne283ed94d0","c":"3","t":"Blood pressure","f":"Blood pressure","b":"force of blood on vessel walls","k":"b"},{"i":"nab38137734","c":"3","t":"Blood pressure","f":"Systolic","b":"top number, heart pumps","k":"b"},{"i":"n1d94fa3ce6","c":"3","t":"Blood pressure","f":"Diastolic","b":"bottom number, heart rests","k":"b"},{"i":"n2d37e841b5","c":"3","t":"Blood pressure","f":"Normal","b":"120/80 or lower","k":"b"},{"i":"n48c13f2e36","c":"3","t":"Blood pressure","f":"High","b":"140/90 or higher","k":"b"},{"i":"nfa6571a3e1","c":"3","t":"Blood pressure","f":"Low (slides)","b":"110/60 hypotension","k":"b"},{"i":"nf63c849dda","c":"3","t":"Blood pressure","f":"Table","b":"normal <120 and <80; elevated 120–129 and <80; stage 1 130–139 or 80–89; stage 2 ≥140 or ≥90; crisis >180 and/or >120","k":"b"},{"i":"nc0d4929659","c":"3","t":"Blood pressure","f":"Reduce risk","b":"less salt, exercise, healthy weight, fresh food, no smoking, medical advice","k":"b"},{"i":"n3ea95f2b00","c":"3","t":"Heart, stroke, diabetes","f":"CVD","b":"heart or blood vessels; atherosclerosis, clots","k":"b"},{"i":"n06ec2eb009","c":"3","t":"Heart, stroke, diabetes","f":"CVD risk factors","b":"high BP, smoking, high cholesterol, diabetes, inactivity, overweight, family history, ethnic background","k":"b"},{"i":"n371c82553f","c":"3","t":"Heart, stroke, diabetes","f":"Heart attack","b":"blocked flow to the heart; plaque in coronary arteries; rupture → clot","k":"b"},{"i":"nc2bc4c1cbe","c":"3","t":"Heart, stroke, diabetes","f":"Stroke","b":"sudden interruption of blood to the brain; ischemic (blockage, most) or hemorrhagic (vessel bursts)","k":"b"},{"i":"nbc4145fb42","c":"3","t":"Heart, stroke, diabetes","f":"Diabetes","b":"high blood glucose; insulin moves glucose into cells","k":"b"},{"i":"n509966b117","c":"3","t":"Heart, stroke, diabetes","f":"Type 1","b":"children, little or no insulin, daily injections","k":"b"},{"i":"nb392ea6ac7","c":"3","t":"Heart, stroke, diabetes","f":"Type 2","b":"adults, ~90%, poor use of insulin; healthy lifestyle","k":"b"},{"i":"n778bc79f75","c":"3","t":"Heart, stroke, diabetes","f":"Gestational","b":"in pregnancy; later type 2 risk","k":"b"},{"i":"n0c5052116e","c":"3","t":"Cancer","f":"Cancer","b":"abnormal cell growth that can invade or spread; benign tumors don't spread","k":"b"},{"i":"nbd6fab348d","c":"3","t":"Cancer","f":"Carcinoma","b":"skin or lining of organs and glands; most common (prostate, breast, lung, colorectal)","k":"b"},{"i":"nb17aa9db9c","c":"3","t":"Cancer","f":"Sarcoma","b":"supporting and connective tissue (fat, muscle, bone, cartilage)","k":"b"},{"i":"nd80ae395c1","c":"3","t":"Cancer","f":"Leukemia","b":"blood; 4 types (ALL, CLL, AML, CML)","k":"b"},{"i":"n1d3a6ebf67","c":"3","t":"Cancer","f":"Lymphoma","b":"lymphatic system; Hodgkin (Reed-Sternberg cells, orderly spread) vs non-Hodgkin","k":"b"},{"i":"n8b6f74d348","c":"3","t":"Cancer","f":"Adenoma","b":"thyroid, pituitary, adrenal, glandular tissue","k":"b"},{"i":"nfb7b461bf7","c":"3","t":"Cancer","f":"Benign","b":"small, slow, localized","k":"b"},{"i":"na73adb6897","c":"3","t":"Cancer","f":"Malignant","b":"large, fast, invasive, metastasize","k":"b"},{"i":"ne52ac20a89","c":"3","t":"Cancer","f":"Warning sign","b":"unexplained weight loss","k":"b"}]}